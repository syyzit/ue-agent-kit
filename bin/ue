#!/usr/bin/env python3
"""Drive an Unreal Editor from the shell over Epic's official Unreal MCP plugin.

Project = nearest *.uproject above the cwd, or $UE_PROJECT.
Engine  = /Users/Shared/Epic Games/UE_<EngineAssociation>, or $UE_ENGINE.

  ue new <Name> [dir] [--template TP_Blank|TP_BlankBP|...]  create a project from an engine template
                               (C++ templates are renamed; feature-pack content is not copied)
  ue setup [--port N]          enable Unreal MCP + toolsets + AgentTools in this project, write .mcp.json
  ue start | stop | restart    editor lifecycle (start waits for MCP; stop waits for the port to free)
  ue status                    editor process / MCP state
  ue build                     compile the <Project>Editor target (editor must be stopped)
  ue log [-n N] [-g REGEX]     tail the editor log (default 40 lines)
  ue headless script.py        run Python with no editor UI (UnrealEditor-Cmd); prints LogPython output
  ue shot [out.png]            screenshot the whole editor as the user sees it (includes PIE + HUD)
  ue shot --game [out.png] [--size WxH]  PIE game view only, rendered at WxH (default 1600x900; no UI/HUD)
  ue windows | ue close <title>  list / close top-level editor windows (popups that cover shots)
  ue capture [out.png] [--annotate]  render the level viewport from the editor camera;
                               --annotate overlays a metre grid + actor labels for spatial work

  ue list                      list toolsets
  ue describe <toolset>        describe a toolset's tools
  ue call <toolset.tool> [json | key=value ...]  call any toolset tool (images in results are saved as PNGs)
                               httpie-style: key=string  key:=json  key=@file (file contents as a string)
  ue tools                     raw MCP tools/list
  ue py '<code>' | ue py -f f.py   run Python in the editor (AgentTools.exec_python; `result = x` returns x)
  ue cmd '<console command>'   run a console command (PIE world when playing)
  ue play | ue stop-play       start / end Play-In-Editor
  ue input <IA path> [x [y z]] [--for S] [--wait]  hold an Enhanced Input action in PIE (default 1.0 for 0.1s);
                               --wait blocks until released
"""

import base64
import glob
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

KIT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
DEFAULT_PORT = 18765
PY_TOOLSET = "agent_tools.tools.AgentTools"
SETTINGS_SECTION = "/Script/ModelContextProtocolEngine.ModelContextProtocolSettings"
# AllToolsets pulls in GameFeatures, which logs a load error without this Asset Manager rule.
GAME_FEATURE_RULE = ('+PrimaryAssetTypesToScan=(PrimaryAssetType="GameFeatureData",'
                     'AssetBaseClass="/Script/GameFeatures.GameFeatureData",bHasBlueprintClasses=False,'
                     'bIsEditorOnly=False,Directories=((Path="/Game/Unused")),SpecificAssets=,'
                     'Rules=(Priority=-1,ChunkId=-1,bApplyRecursively=True,CookRule=AlwaysCook))')
PLUGINS = ["ModelContextProtocol", "AllToolsets", "PythonScriptPlugin", "EditorScriptingUtilities", "AgentTools"]
IMAGE_DIR = os.environ.get("UE_IMAGE_DIR", "/tmp/ue-captures")


# ---------------------------------------------------------------- project / engine

def find_project():
    if os.environ.get("UE_PROJECT"):
        return os.path.abspath(os.environ["UE_PROJECT"])
    d = os.getcwd()
    while d != "/":
        hits = glob.glob(os.path.join(d, "*.uproject"))
        if hits:
            return hits[0]
        d = os.path.dirname(d)
    raise SystemExit("no *.uproject above the cwd (set UE_PROJECT)")


def project_name(uproject):
    return os.path.splitext(os.path.basename(uproject))[0]


def engine_dir(uproject):
    if os.environ.get("UE_ENGINE"):
        return os.environ["UE_ENGINE"]
    assoc = json.load(open(uproject)).get("EngineAssociation") or ""
    if assoc:
        d = f"/Users/Shared/Epic Games/UE_{assoc}"
        if os.path.isdir(d):
            return d
    installs = sorted(glob.glob("/Users/Shared/Epic Games/UE_5.*"))
    if not installs:
        raise SystemExit("no engine found (set UE_ENGINE)")
    return installs[-1]


def settings_ini(uproject):
    return os.path.join(os.path.dirname(uproject), "Config", "DefaultEditorPerProjectUserSettings.ini")


def port(uproject):
    if os.environ.get("UE_MCP_PORT"):
        return int(os.environ["UE_MCP_PORT"])
    try:
        m = re.search(r"^ServerPortNumber=(\d+)", open(settings_ini(uproject)).read(), re.M)
        if m:
            return int(m.group(1))
    except FileNotFoundError:
        pass
    return 8000  # plugin default


def url(uproject):
    return f"http://127.0.0.1:{port(uproject)}/mcp"


def log_path(uproject):
    name = project_name(uproject)
    return os.path.expanduser(f"~/Library/Logs/Unreal Engine/{name}Editor/{name}.log")


# ---------------------------------------------------------------- MCP client

def _post(endpoint, payload, session=None, timeout=600):
    headers = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream"}
    if session:
        headers["Mcp-Session-Id"] = session
    req = urllib.request.Request(endpoint, json.dumps(payload).encode(), headers)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        sid = resp.headers.get("Mcp-Session-Id") or session
        body = resp.read().decode()
    if not body.strip():
        return None, sid
    if body.lstrip().startswith("{"):
        return json.loads(body), sid
    msg = None  # SSE: keep the last data: line carrying a JSON-RPC message
    for line in body.splitlines():
        if line.startswith("data:"):
            msg = json.loads(line[5:].strip())
    return msg, sid


def rpc(uproject, method, params):
    endpoint = url(uproject)
    try:
        init = {"jsonrpc": "2.0", "id": 0, "method": "initialize",
                "params": {"protocolVersion": "2025-06-18", "capabilities": {},
                           "clientInfo": {"name": "ue-cli", "version": "1"}}}
        _, sid = _post(endpoint, init, timeout=10)
        _post(endpoint, {"jsonrpc": "2.0", "method": "notifications/initialized"}, sid, timeout=10)
        msg, _ = _post(endpoint, {"jsonrpc": "2.0", "id": 1, "method": method, "params": params}, sid)
    except (urllib.error.URLError, ConnectionError) as e:
        raise SystemExit(f"MCP not reachable at {endpoint} ({e}); is the editor running? `ue start`")
    if msg is None:
        raise SystemExit("empty response")
    if "error" in msg:
        raise SystemExit(json.dumps(msg["error"], indent=2))
    return msg["result"]


def call_tool(uproject, name, arguments):
    result = rpc(uproject, "tools/call", {"name": name, "arguments": arguments})
    out = "\n".join(c.get("text", "") for c in result.get("content", []) if c.get("type") == "text")
    if result.get("isError"):
        raise SystemExit(out)
    return out


def parse_args(args):
    """`'{"a": 1}'` or httpie-style `name=text n:=1 obj:='{"x": 1}' code=@file.dsl` -> dict."""
    if len(args) == 1 and args[0].lstrip().startswith("{"):
        return json.loads(args[0])
    out = {}
    for a in args:
        m = re.match(r"([^=:]+)(:=|=)(.*)", a, re.S)
        if not m:
            raise SystemExit(f"expected key=value or key:=json, got {a!r}")
        key, op, value = m.groups()
        if op == ":=":
            try:
                out[key] = json.loads(value)
            except ValueError as e:
                raise SystemExit(f"{key}:= needs valid JSON ({e}): {value!r}")
        elif value.startswith("@"):
            out[key] = open(value[1:]).read()
        else:
            out[key] = value
    return out


def save_images(text, out=None):
    """Replace base64 images inside a JSON tool result with paths of saved PNG files."""
    try:
        value = json.loads(text)
    except ValueError:
        return text
    saved = []

    def walk(o):
        if isinstance(o, dict):
            if str(o.get("mimeType", "")).startswith("image/") and isinstance(o.get("data"), str):
                ext = o["mimeType"].split("/")[1]
                path = out if out and not saved else os.path.join(
                    IMAGE_DIR, f"{time.strftime('%H%M%S')}-{len(saved)}.{ext}")
                os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
                open(path, "wb").write(base64.b64decode(o["data"]))
                saved.append(path)
                return {"mimeType": o["mimeType"], "file": path}
            return {k: walk(v) for k, v in o.items()}
        if isinstance(o, list):
            return [walk(v) for v in o]
        return o

    value = walk(value)
    return json.dumps(value, indent=1) if saved else text


def toolset_call(uproject, toolset, tool, arguments, out=None):
    text = call_tool(uproject, "call_tool", {"toolset_name": toolset, "tool_name": tool, "arguments": arguments})
    return save_images(text, out)


def py(uproject, code):
    out = toolset_call(uproject, PY_TOOLSET, "exec_python", {"code": code})
    try:  # results come back JSON-wrapped; unwrap to plain text
        v = json.loads(out)
        if isinstance(v, dict) and len(v) == 1:
            v = next(iter(v.values()))
        return v if isinstance(v, str) else out
    except ValueError:
        return out


# ---------------------------------------------------------------- editor lifecycle

def running(uproject):
    return subprocess.run(["pgrep", "-f", f"UnrealEditor.*{re.escape(os.path.basename(uproject))}"],
                          capture_output=True).returncode == 0


def port_busy(p):
    """True while anything holds the port, including TIME_WAIT left by a just-closed editor.

    Unreal's HttpListener binds without SO_REUSEADDR, so a lingering TIME_WAIT makes the
    MCP server fail to start even though nothing is listening any more.
    """
    with socket.socket() as s:
        try:
            s.bind(("127.0.0.1", p))
            return False
        except OSError:
            return True


def mcp_up(uproject):
    try:
        _post(url(uproject), {"jsonrpc": "2.0", "id": 0, "method": "initialize",
                               "params": {"protocolVersion": "2025-06-18", "capabilities": {},
                                          "clientInfo": {"name": "probe", "version": "0"}}}, timeout=2)
        return True
    except Exception:
        return False


def log_marker(log):
    try:
        st = os.stat(log)
        return st.st_ino, st.st_size
    except FileNotFoundError:
        return None, 0


def bind_failed(log, marker, p):
    """Scan only what this launch wrote. The editor rotates the log on start (new inode)."""
    inode, size = log_marker(log)
    if inode is None:
        return False
    with open(log, errors="replace") as f:
        f.seek(marker[1] if inode == marker[0] else 0)
        return f"unable to bind to 127.0.0.1:{p}" in f.read()


def start(uproject):
    if running(uproject):
        print("already running")
        return
    p = port(uproject)
    for i in range(90):
        if not port_busy(p):
            break
        if i == 0:
            print(f"port {p} busy (another editor, or TIME_WAIT from the last one); waiting up to 90s")
        time.sleep(1)
    else:
        raise SystemExit(f"port {p} still busy; another editor or server is using it (`lsof -nP -iTCP:{p}`)")
    log = log_path(uproject)
    marker = log_marker(log)
    app = os.path.join(engine_dir(uproject), "Engine/Binaries/Mac/UnrealEditor.app")
    subprocess.run(["open", "-n", "-a", app, "--args", uproject,
                    "-ModelContextProtocolStartServer", f"-ModelContextProtocolPort={p}"], check=True)
    t0 = time.time()
    while time.time() - t0 < 900:
        if mcp_up(uproject):
            print(f"mcp up on :{p} after {int(time.time() - t0)}s")
            # Startup notices (asset/map checks) open a floating Message Log that covers screenshots.
            time.sleep(1)
            try:
                if close_window(uproject, "Message Log"):
                    print("closed the startup Message Log popup (see `ue log -g 'Error|Warning'`)")
            except SystemExit:
                pass
            return
        if time.time() - t0 > 60 and not running(uproject):
            raise SystemExit(f"editor exited during startup; see `ue log`")
        if bind_failed(log, marker, p):
            raise SystemExit(f"editor is up but the MCP server could not bind :{p}. Run `ue restart`, or type "
                             f"`ModelContextProtocol.StartServer` in the editor console")
        time.sleep(1)
    raise SystemExit("editor started but MCP never came up; see `ue log -g ModelContextProtocol`")


def stop(uproject):
    if running(uproject):
        try:
            py(uproject, "unreal.SystemLibrary.quit_editor()")
        except SystemExit:
            subprocess.run(["pkill", "-INT", "-f", f"UnrealEditor.*{re.escape(os.path.basename(uproject))}"])
    for _ in range(120):
        if not running(uproject) and not port_busy(port(uproject)):
            print("stopped")
            return
        time.sleep(1)
    raise SystemExit("editor did not stop within 120s")


def headless(uproject, script):
    cmd = os.path.join(engine_dir(uproject), "Engine/Binaries/Mac/UnrealEditor-Cmd")
    # Output goes to a file, not a pipe: UnrealTraceServer daemonizes with our stdout and would
    # hold a pipe open forever.
    with tempfile.TemporaryFile("w+") as f:
        subprocess.run([cmd, uproject, "-run=pythonscript", f"-script={os.path.abspath(script)}",
                        "-unattended", "-nullrhi", "-nosplash", "-stdout", "-AllowStdOutLogVerbosity"],
                       stdout=f, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
        f.seek(0)
        output = f.read()
    ok = False
    for line in output.splitlines():
        m = re.search(r"\]LogPython: (.*)", line)
        if m and "start-up script" not in m.group(1) and "pip-enabled" not in m.group(1):
            print(m.group(1))
        ok = ok or "Python script executed successfully" in line
    if not ok:
        print("\n".join(l for l in output.splitlines() if "Error" in l)[-4000:], file=sys.stderr)
    sys.exit(0 if ok else 1)


def build(uproject):
    if running(uproject):
        raise SystemExit("stop the editor first (or use Live Coding from inside it)")
    script = os.path.join(engine_dir(uproject), "Engine/Build/BatchFiles/Mac/Build.sh")
    proc = subprocess.run([script, f"{project_name(uproject)}Editor", "Mac", "Development",
                           f"-Project={uproject}", "-WaitMutex"], capture_output=True, text=True)
    for line in (proc.stdout + proc.stderr).splitlines():
        if re.search(r"error|warning:|Result:", line):
            print(line)
    sys.exit(proc.returncode)


def capture(uproject, out, annotate):
    # The plugin rejects omitted "optional" struct params; explicit nulls work.
    notes = {"gridSpacing": 100, "gridExtent": 5000, "gridHeight": 0, "maxLabelDistance": 10000,
             "classFilter": None, "maxLabels": 20} if annotate else None
    return toolset_call(uproject, "EditorToolset.EditorAppToolset", "CaptureViewport",
                        {"captureTransform": None, "annotations": notes}, out)


def game_shot(uproject, out, size):
    """HighResShot in the PIE world; the engine writes the PNG asynchronously under Saved/Screenshots."""
    shots = os.path.join(os.path.dirname(uproject), "Saved", "Screenshots")
    before = set(glob.glob(os.path.join(shots, "**", "*.png"), recursive=True))
    res = json.loads(toolset_call(uproject, PY_TOOLSET, "console", {"command": f"HighResShot {size}"}))
    if "UEDPIE" not in res.get("returnValue", ""):
        raise SystemExit("PIE is not running (`ue play`); for the editor viewport use `ue capture`")
    for _ in range(100):
        new = set(glob.glob(os.path.join(shots, "**", "*.png"), recursive=True)) - before
        if new:
            src = new.pop()
            time.sleep(0.2)  # let the writer finish
            out = out or os.path.join(IMAGE_DIR, f"{time.strftime('%H%M%S')}-game.png")
            os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
            shutil.move(src, out)
            return out
        time.sleep(0.1)
    raise SystemExit("HighResShot produced no file within 10s; see `ue log -g Screenshot`")


def windows(uproject):
    text = toolset_call(uproject, "SlateInspectorToolset.SlateInspectorToolset", "Windows", {"action": "list"})
    return json.loads(json.loads(text)["returnValue"])


def close_window(uproject, title):
    """Close the first top-level window whose title contains `title` (never the main editor window)."""
    for w in windows(uproject):
        if title.lower() in w["title"].lower() and not w["title"].endswith("Unreal Editor"):
            toolset_call(uproject, "SlateInspectorToolset.SlateInspectorToolset", "Windows",
                         {"action": "close", "index": w["index"]})
            return w["title"]
    return None


# ---------------------------------------------------------------- setup

def setup(uproject, new_port):
    root = os.path.dirname(uproject)
    d = json.load(open(uproject))
    plugins = d.setdefault("Plugins", [])
    for name in PLUGINS:
        entry = next((p for p in plugins if p["Name"] == name), None)
        if entry:
            entry["Enabled"] = True
        else:
            plugins.append({"Name": name, "Enabled": True})
    with open(uproject, "w") as f:
        f.write(json.dumps(d, indent="\t") + "\n")

    dst = os.path.join(root, "Plugins", "AgentTools")
    shutil.rmtree(dst, ignore_errors=True)
    shutil.copytree(os.path.join(KIT, "plugin", "AgentTools"), dst)

    ini = settings_ini(uproject)
    os.makedirs(os.path.dirname(ini), exist_ok=True)
    text = open(ini).read() if os.path.exists(ini) else ""
    p = new_port or (port(uproject) if f"[{SETTINGS_SECTION}]" in text else DEFAULT_PORT)
    block = f"[{SETTINGS_SECTION}]\nbAutoStartServer=True\nServerPortNumber={p}\nbEnableToolSearch=True\n"
    pattern = re.compile(r"^\[" + re.escape(SETTINGS_SECTION) + r"\]\n(?:(?!\[).*\n?)*", re.M)
    text = pattern.sub(block, text) if pattern.search(text) else (text.rstrip() + "\n\n" + block).lstrip()
    open(ini, "w").write(text)

    game_ini = os.path.join(root, "Config", "DefaultGame.ini")
    game = open(game_ini).read() if os.path.exists(game_ini) else ""
    if 'PrimaryAssetType="GameFeatureData"' not in game:
        section = "[/Script/Engine.AssetManagerSettings]"
        if section in game:
            game = game.replace(section, section + "\n" + GAME_FEATURE_RULE, 1)
        else:
            game = game.rstrip() + f"\n\n{section}\n{GAME_FEATURE_RULE}\n"
        open(game_ini, "w").write(game.lstrip())

    mcp_json = os.path.join(root, ".mcp.json")
    cfg = json.load(open(mcp_json)) if os.path.exists(mcp_json) else {}
    cfg.setdefault("mcpServers", {}).pop("unreal", None)
    cfg["mcpServers"]["unreal-mcp"] = {"type": "http", "url": f"http://127.0.0.1:{p}/mcp"}
    open(mcp_json, "w").write(json.dumps(cfg, indent=2) + "\n")

    print(f"{project_name(uproject)}: plugins {', '.join(PLUGINS)} enabled; AgentTools copied; "
          f"MCP on :{p}; .mcp.json written.")
    if os.path.isdir(os.path.join(root, "Source")):
        print("C++ project: run `ue build` before `ue start`.")


def new_project(name, parent, template):
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]{0,19}", name):
        raise SystemExit("project name: letters, digits, underscore; max 20 chars; starts with a letter")
    engines = sorted(glob.glob("/Users/Shared/Epic Games/UE_5.*"))
    engine = os.environ.get("UE_ENGINE") or (engines[-1] if engines else None)
    if not engine:
        raise SystemExit("no engine found (set UE_ENGINE)")
    src = os.path.join(engine, "Templates", template)
    if not os.path.isdir(src):
        raise SystemExit(f"no template {template}; see {os.path.join(engine, 'Templates')}")
    dst = os.path.abspath(os.path.join(parent, name))
    if os.path.exists(dst):
        raise SystemExit(f"{dst} exists")
    shutil.copytree(src, dst, ignore=shutil.ignore_patterns("Media", "TemplateDefs.ini", "Binaries", "Intermediate"))
    old = template
    # Rename files and dirs bottom-up, then identifiers inside text files (module name + API macro).
    for root, dirs, files in os.walk(dst, topdown=False):
        for n in files + dirs:
            if old in n:
                os.rename(os.path.join(root, n), os.path.join(root, n.replace(old, name)))
    for root, _, files in os.walk(dst):
        for n in files:
            if n.endswith((".uproject", ".cs", ".h", ".cpp", ".ini")):
                f = os.path.join(root, n)
                t = open(f, errors="replace").read()
                t2 = t.replace(old, name).replace(old.upper(), name.upper())
                if t2 != t:
                    open(f, "w").write(t2)
    up = os.path.join(dst, f"{name}.uproject")
    d = json.load(open(up))
    d["EngineAssociation"] = os.path.basename(engine).replace("UE_", "")
    open(up, "w").write(json.dumps(d, indent="\t") + "\n")
    open(os.path.join(dst, ".gitignore"), "w").write(
        "Binaries/\nIntermediate/\nSaved/\nDerivedDataCache/\n.DS_Store\n*.xcworkspace\n")
    print(f"created {up} from {template}\nnext: cd {dst} && ue setup" +
          (" && ue build" if os.path.isdir(os.path.join(dst, "Source")) else "") + " && ue start")


# ---------------------------------------------------------------- main

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "new":
        args = [a for i, a in enumerate(rest) if not a.startswith("--") and (i == 0 or rest[i - 1] != "--template")]
        template = rest[rest.index("--template") + 1] if "--template" in rest else "TP_Blank"
        new_project(args[0], args[1] if len(args) > 1 else ".", template)
        return
    up = find_project()
    if cmd == "setup":
        setup(up, int(rest[rest.index("--port") + 1]) if "--port" in rest else None)
    elif cmd == "start":
        start(up)
    elif cmd == "stop":
        stop(up)
    elif cmd == "restart":
        stop(up)
        start(up)
    elif cmd == "status":
        print(f"project  {up}\nengine   {engine_dir(up)}\nmcp      {url(up)}")
        print("editor   " + ("running" if running(up) else "stopped"))
        print("mcp      " + ("up" if mcp_up(up) else "down"))
    elif cmd == "build":
        build(up)
    elif cmd == "log":
        n = int(rest[rest.index("-n") + 1]) if "-n" in rest else 40
        lines = open(log_path(up), errors="replace").read().splitlines()
        if "-g" in rest:
            rx = re.compile(rest[rest.index("-g") + 1], re.I)
            lines = [l for l in lines if rx.search(l)]
        print("\n".join(lines[-n:]))
    elif cmd == "headless":
        headless(up, rest[0])
    elif cmd == "shot":
        size = rest[rest.index("--size") + 1] if "--size" in rest else "1600x900"
        out = next((a for a in rest if not a.startswith("-") and a != size), None)
        if "--game" in rest:
            print(game_shot(up, os.path.abspath(out) if out else None, size))
        else:
            print(toolset_call(up, "EditorToolset.EditorAppToolset", "CaptureEditorImage", {}, out))
    elif cmd == "windows":
        for w in windows(up):
            print(w["index"], w["title"])
    elif cmd == "close":
        closed = close_window(up, " ".join(rest))
        print(f"closed {closed}" if closed else "no matching window")
    elif cmd == "capture":
        out = next((a for a in rest if not a.startswith("-")), None)
        print(capture(up, out, "--annotate" in rest))
    elif cmd == "tools":
        print(json.dumps(rpc(up, "tools/list", {}), indent=2))
    elif cmd == "list":
        print(call_tool(up, "list_toolsets", {}))
    elif cmd == "describe":
        print(call_tool(up, "describe_toolset", {"toolset_name": rest[0]}))
    elif cmd == "call":
        toolset, tool = rest[0].rsplit(".", 1)
        print(toolset_call(up, toolset, tool, parse_args(rest[1:])))
    elif cmd == "py":
        code = open(rest[1]).read() if rest[0] == "-f" else rest[0]
        print(py(up, code))
    elif cmd == "cmd":
        print(toolset_call(up, PY_TOOLSET, "console", {"command": " ".join(rest)}))
    elif cmd == "input":
        secs, vals, wait, i = 0.1, [], False, 1
        while i < len(rest):
            if rest[i] == "--for":
                secs, i = float(rest[i + 1]), i + 2
                continue
            if rest[i] == "--wait":
                wait = True
            else:
                vals.append(float(rest[i]))
            i += 1
        x, y, z = (vals + [1.0, 0.0, 0.0][len(vals):])[:3]
        print(json.loads(toolset_call(up, PY_TOOLSET, "hold_input",
                                      {"action": rest[0], "x": x, "y": y, "z": z, "seconds": secs}))["returnValue"])
        if wait:
            time.sleep(secs + 0.1)
    elif cmd == "play":
        print(py(up, "unreal.get_editor_subsystem(unreal.LevelEditorSubsystem).editor_request_begin_play()"))
    elif cmd == "stop-play":
        print(py(up, "unreal.get_editor_subsystem(unreal.LevelEditorSubsystem).editor_request_end_play()"))
    else:
        raise SystemExit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
